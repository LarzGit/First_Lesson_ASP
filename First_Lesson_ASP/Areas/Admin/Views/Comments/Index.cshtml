@model IEnumerable<First_Lesson_ASP.Entities.Comment>
@{
    ViewData["Title"] = "Керування коментарями";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-chat-left-text me-2"></i> Всі коментарі</h2>
        @* Додаємо asp-area="Admin", щоб кнопка назад завжди працювала *@
        <a asp-area="Admin" asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">Назад в меню</a>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle bg-white">
            <thead class="table-dark">
                <tr>
                    <th>Автор</th>
                    <th>Повідомлення</th>
                    <th>До посту</th>
                    <th>Дата</th>
                    <th class="text-center">Дії</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">@item.Name</td>
                        <td class="text-truncate" style="max-width: 300px;">@item.Message</td>
                        <td><span class="badge bg-info text-dark">@item.Post?.Title</span></td>
                        <td class="small">@item.DateOfPublished.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-center">
                            @* Явно вказуємо Area та Controller для методу Delete *@
                            <form asp-area="Admin" asp-controller="Comments" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Видалити цей коментар?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i> Видалити
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>